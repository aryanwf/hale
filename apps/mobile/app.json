{
  "expo": {
    "name": "Hale",
    "slug": "hale-mobile",
    "platforms": ["android"],
    "scheme": "hale",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF7F5",
    "icon": "./assets/icon.png",
    "android": {
      "package": "health.hale.mobile",
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      ["expo-camera", {
        "cameraPermission": "Hale uses your camera only to scan a family dashboard QR code when you choose to connect.",
        "recordAudioAndroid": false,
        "barcodeScannerEnabled": true
      }],
      ["expo-audio", {
        "microphonePermission": "Hale records conversations only when you start recording and everyone taking part agrees. Recording can continue when your screen locks.",
        "enableBackgroundRecording": true,
        "enableBackgroundPlayback": false
      }],
      "./plugins/with-windows-native-build.cjs",
      "./plugins/with-android-network-dependencies.cjs",
      "expo-font",
      "expo-secure-store",
      ["@clerk/expo", { "theme": "./clerk-theme.json" }]
    ]
  }
}
