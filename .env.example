# Populated by `bunx convex dev`. Never commit actual deployment credentials.
# CONVEX_DEPLOYMENT=dev:your-deployment

# Set these on the Convex deployment, not in public/browser configuration:
# bunx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-clerk-domain
# bunx convex env set APP_ORIGIN http://localhost:3001
# bunx convex env set SARVAM_API_KEY your-sarvam-api-key
# Sarvam speech, chat, and translation adapter. Never expose this as NEXT_PUBLIC_*.
# Optional care-alert email delivery through Resend; both values stay on Convex.
# bunx convex env set RESEND_API_KEY your-resend-api-key
# bunx convex env set EMAIL_FROM 'Hale <notifications@example.com>'
# Optional background web push. Generate a key pair once with `bunx web-push generate-vapid-keys`.
# Keep the private key only on Convex; the public key is returned only to authorized family members.
# bunx convex env set VAPID_PUBLIC_KEY your-vapid-public-key
# bunx convex env set VAPID_PRIVATE_KEY your-vapid-private-key
# bunx convex env set VAPID_SUBJECT 'mailto:notifications@example.com'
# Optional hosted voice enrollment. Keep this key only on the Convex deployment.
# bunx convex env set PYANNOTE_API_KEY your-pyannote-api-key
