{
  "expo": {
    "name": "Hale",
    "slug": "hale-mobile",
    "scheme": "hale",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF7F5",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "health.hale.mobile",
      "infoPlist": {
        "UIFileSharingEnabled": false,
        "LSSupportsOpeningDocumentsInPlace": false,
        "NSAppTransportSecurity": { "NSAllowsArbitraryLoads": false, "NSAllowsLocalNetworking": true }
      }
    },
    "android": {
      "package": "health.hale.mobile",
      "allowBackup": false
    },
    "plugins": [
      ["expo-audio", {
        "microphonePermission": "Hale records conversations only when you start recording and everyone taking part agrees. Recording can continue when your screen locks.",
        "enableBackgroundRecording": true,
        "enableBackgroundPlayback": false
      }],
      "expo-font",
      "expo-secure-store",
      ["@clerk/expo", { "theme": "./clerk-theme.json" }]
    ]
  }
}
